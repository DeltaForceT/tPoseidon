<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>tPoseidon.Panel</AssemblyName>
    <RootNamespace>tPoseidon.Panel</RootNamespace>
    <ApplicationIcon>Assets\tposeidon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="tPoseidon.Ui" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="tPoseidon.Panel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\tPoseidon.Core.ClientArt\tPoseidon.Core.ClientArt.csproj" />
    <ProjectReference Include="..\tPoseidon.Hosting\tPoseidon.Hosting.csproj" />
    <ProjectReference Include="..\tPoseidon.LauncherKit\tPoseidon.LauncherKit.csproj" />
    <ProjectReference Include="..\tPoseidon.Ui\tPoseidon.Ui.csproj" />
  </ItemGroup>

</Project>
