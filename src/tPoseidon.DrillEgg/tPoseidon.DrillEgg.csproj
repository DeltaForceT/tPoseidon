<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>tPoseidon.DrillEgg</RootNamespace>
    <AssemblyName>drill-egg</AssemblyName>
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\tPoseidon.Core.Data\tPoseidon.Core.Data.csproj" />
    <ProjectReference Include="..\tPoseidon.Core.Data.Postgres\tPoseidon.Core.Data.Postgres.csproj" />
    <ProjectReference Include="..\tPoseidon.Core.Game\tPoseidon.Core.Game.csproj" />
    <ProjectReference Include="..\tPoseidon.Gacha.Art\tPoseidon.Gacha.Art.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="tPoseidon.DrillEgg.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="pack\**;site\**" />
    <None Remove="pack\**;site\**" />
    <Content Include="site\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\tPoseidon.WebShop\pages\gacha\player.js;..\tPoseidon.WebShop\pages\gacha\drill.js;..\tPoseidon.WebShop\pages\gacha\drill.css" Link="site\gacha\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
